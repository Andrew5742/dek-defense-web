{
  "name": "dek-defense-hybrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/dek-defense-web/",
    "deploy:pages": "npm run build:pages && gh-pages -d dist -b gh-pages --dotfiles -m \"deploy: manual\"",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "electron-store": "^11.0.2",
    "firebase": "11.10.0",
    "mammoth": "1.9.1",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "7.1.10"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^14.17.0",
    "gh-pages": "^6.3.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20 <=22"
  }
}
