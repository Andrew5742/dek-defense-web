{
  "name": "dek-defense-electron-agent",
  "version": "0.1.1",
  "private": true,
  "description": "Local Electron Defense Station Agent for DEK Defense Web",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "build:unpacked": "electron-builder --win --dir"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "dotenv": "^16.4.7",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "firebase": "^10.14.1",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.7.76",
    "qrcode": "^1.5.4",
    "rcedit": "^5.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ua.edu.khnu.dek.defense.agent",
    "productName": "DEK Defense Station",
    "artifactName": "DEK Defense Station Setup ${version}.${ext}",
    "executableName": "DEK Defense Station",
    "files": [
      "src/**/*",
      "build/icon.*",
      "package.json",
      ".env",
      ".env.example"
    ],
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "legalTrademarks": "DEK Defense Station"
    },
    "nsis": {
      "artifactName": "DEK Defense Station Setup ${version}.${ext}",
      "shortcutName": "DEK Defense Station",
      "uninstallDisplayName": "DEK Defense Station",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
