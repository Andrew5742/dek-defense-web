# Firebase web config
FIREBASE_API_KEY=<firebase-api-key>
FIREBASE_AUTH_DOMAIN=dek-defence.firebaseapp.com
FIREBASE_PROJECT_ID=dek-defence
FIREBASE_STORAGE_BUCKET=dek-defence.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<firebase-messaging-sender-id>
FIREBASE_APP_ID=<firebase-app-id>

# Firebase auth for station/service account-like user
FIREBASE_EMAIL=<station-firebase-email>
FIREBASE_PASSWORD=<station-firebase-password>

# Station settings
STATION_ID=defense-station-1
STATION_NAME=ПК захисту
UPLOAD_PORT=3050
ZOOM_URL=
WEB_APP_URL=https://dek-defence.web.app/
