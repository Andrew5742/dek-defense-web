rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Draft sync document for the first Firebase-connected build.
    // Tighten before production by moving public writes to scoped student tokens.
    match /dek_app/state {
      allow read: if true;
      allow write: if true;
    }

    match /dek_sessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dek_students/{studentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dek_registrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    match /dek_presentations/{presentationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
    match /dek_commands/{commandId} {
      allow read, write: if true;
    }
    match /dek_stations/{stationId} {
      allow read, write: if true;
    }
    match /student_pages/{token} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly(['registrationConfirmed', 'updatedAt']);
      allow create, delete: if true;
    }
    match /mobile_display/{sessionId} {
      allow read: if true;
      allow write: if true;
    }
    match /dek_events/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
